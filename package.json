{
  "name": "wikiman-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "productName": "Wikiman",
  "description": "Personal wiki",
  "scripts": {
    "dev": "quasar dev",
    "dev:pwa": "quasar dev -m pwa",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "build:backend": "npm run build:pwa && node scripts/copy-to-backend.mjs",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "postinstall": "quasar prepare",
    "lint": "node scripts/syntax-check.mjs",
    "test": "node --test test/**/*.test.js",
    "check": "npm run lint && npm test && npm run build:pwa"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^8.2.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@editorjs/code": "^2.9.3",
    "@editorjs/editorjs": "^2.31.0",
    "@editorjs/header": "^2.8.8",
    "@editorjs/image": "^2.10.3",
    "@editorjs/list": "^2.0.8",
    "@editorjs/table": "^2.4.5",
    "@quasar/extras": "^2.0.3",
    "axios": "^1.11.0",
    "ckeditor5": "^48.4.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.3",
    "plantuml-encoder": "^1.4.0",
    "quasar": "^2.24.0",
    "vue": "^3.5.18",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.5.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sass-embedded": "^1.90.0",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
